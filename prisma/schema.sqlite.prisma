// This file is copied to prisma/schema.prisma by scripts/select-db-schema.mjs.
// Do not edit prisma/schema.prisma directly — edit this file and
// prisma/schema.postgresql.prisma instead, and keep the `model` blocks in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Attendee {
  id                    String          @id @default(uuid())
  fullName              String
  organization          String
  role                  String
  email                 String          @unique
  phone                 String?
  dietaryRequirements   String?
  accessibilityNeeds    String?
  travelDetails         String?
  qrCodeId              String?         @unique
  accommodationDetails  String?
  createdAt             DateTime        @default(now())
  attendanceLogs        AttendanceLog[]
}

model AttendanceLog {
  id          String   @id @default(uuid())
  attendeeId  String
  attendee    Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  checkInDate String
  checkInTime DateTime @default(now())

  @@unique([attendeeId, checkInDate])
}
