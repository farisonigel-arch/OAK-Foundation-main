# Copy this file to .env for local development (SQLite).
DATABASE_URL="file:./dev.db"

# --- Production (Vercel) ---
# Do NOT put the production value here. Instead, set DATABASE_URL in the
# Vercel project's Environment Variables (Production/Preview) to your
# Postgres connection string, e.g. from Vercel Postgres or Neon:
#   DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
